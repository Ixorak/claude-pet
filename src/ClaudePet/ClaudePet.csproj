<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ClaudePet</AssemblyName>
    <RootNamespace>ClaudePet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Claude Pet</Product>
    <AssemblyTitle>Claude Pet</AssemblyTitle>
    <Company>Ixorak</Company>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Publication native (AOT) : un seul .exe, sans runtime à installer, démarrage instantané. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <TrimMode>full</TrimMode>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\..\assets\house.ico')">
    <ApplicationIcon>..\..\assets\house.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
